# =============================================
#   VALORIZA API - Variáveis de Ambiente
# =============================================

# --- Servidor ---
PORT=3000

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=valoriza_db

# --- JWT (gere uma chave segura em: https://generate-secret.vercel.app/32) ---
JWT_SECRET=coloque_uma_chave_secreta_muito_forte_aqui
JWT_EXPIRES_IN=7d

# --- PagSeguro ---
# Token gerado em: Minha Conta > Preferências > Token de Segurança (pagseguro.uol.com.br)
PAGSEGURO_TOKEN=seu_token_pagseguro_aqui

# Use 'sandbox' para testes e 'production' para produção
PAGSEGURO_ENV=sandbox

# URL base do seu backend (usada para o webhook do PagSeguro)
APP_URL=https://seu-app.onrender.com

# --- Planos (valores em centavos) ---
PLAN_MONTHLY_PRICE=2990
PLAN_MONTHLY_NAME=Valoriza Mensal
